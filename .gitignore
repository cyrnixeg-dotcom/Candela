# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database files
!prisma/dev.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# Temporary / recovery / scratch files
call_*.json
recovered*
del_old.js
search_all.js
fix_*.js
optimize.js
recover_all*.js
rename_and_seed*.js
update_candles.js
update_images.js
apply_fixes.js
list_users.js
seed_admin.js


.vercel
