// Prisma schema for Candela e-commerce

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Float
  category    String      // "body-beauty" | "candles" | "home-car"
  subcategory String      // "Body Mist" | "Perfume Oil" | etc.
  image       String
  inStock     Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  views       Int         @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  address     String
  city        String
  notes       String?
  total       Float
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  orders    Order[]
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  content    String
  fromOwner  Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String @default("Candela Owner")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String
  page       String
  productId  String?
  deviceType String   @default("unknown")
  createdAt  DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
