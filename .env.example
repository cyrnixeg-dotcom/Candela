# CANDELA Production Environment Variables Template
# Copy this file to .env and set your production values

# Database Connection (SQLite for single-server/VPS/Render, or PostgreSQL for Vercel/Supabase/Neon)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Security
# In production, generate a secure random string (e.g. with: openssl rand -base64 32)
NEXTAUTH_SECRET="candela-production-secret-replace-with-random-32-chars"

# Canonical URL of your deployed website (e.g., https://candela.store or https://your-app.onrender.com)
NEXTAUTH_URL="https://your-domain.com"

# Admin Initial Account (will be auto-created on first run if missing)
ADMIN_EMAIL="admin@candela.store"
ADMIN_PASSWORD="ReplaceWithSecurePassword123!"

# Storefront Settings
STORE_PHONE="+20 100 000 0000"
STORE_WHATSAPP="+20 100 000 0000"
STORE_NAME="CANDELA"
STORE_TAGLINE="Your Feminine Scent"
