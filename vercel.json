{
  "services": {
    "candela-store": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install && npx prisma generate && npx prisma db push && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "candela-store"
      }
    }
  ]
}
